// Local adaptation to observed Swiss temperatures
// All populations share one starting thermal phenotype.
// Warm mutations increase that phenotype and cold mutations decrease it.

initialize()
{
	initializeSLiMModelType("nonWF");
	
	// Input files
	defineConstant("inputDirectory", "C:/Users/WilliamWallisch/msc_workspace/SLiM/input/grib_pop_index_local_adaptation/");
	defineConstant("migrationFile", inputDirectory + "migration_matrix/grib_migration_matrix_2pop.csv");
	defineConstant("climateFile", inputDirectory + "climate_matrix/grib_climate_matrix_2pop_degrees_c.csv");
	defineConstant("yearFile", inputDirectory + "climate_matrix/grib_climate_years_2pop_degrees_c.csv");
	
	// Read the migration data
	migrationTable = readCSV(migrationFile, colNames=F);
	migrationInput = migrationTable.asMatrix();
	print(migrationInput);
	
	// Read the climate data
	climateTable = readCSV(climateFile, colNames=F);
	climateInput = climateTable.asMatrix();
	print(climateInput);
	
	// Read the climate years
	yearTable = readCSV(yearFile, colNames=F);
	yearMatrix = yearTable.asMatrix();
	yearInput = asInteger(drop(yearMatrix));
	
	// Main model parameters
	defineConstant("numPops", nrow(migrationInput));
	defineConstant("migrationMatrix", migrationInput);
	defineConstant("climateMatrix", climateInput);
	defineConstant("climateYears", yearInput);
	defineConstant("K", 5000);
	defineConstant("R", 1.01);
	defineConstant("effectPerMutation", 0.1); // each copy changes the phenotype by 0.1 degrees C
	defineConstant("selectionStrength", 0.05);
	defineConstant("TlocalAdaptation", 2000);
	defineConstant("TclimateChange", 4000);
	
	// Find the historical years and observed climate years
	historicalRows = which((climateYears >= 1940) & (climateYears <= 1970));
	observedRows = which(climateYears >= 1970);
	
	// Calculate the historical mean temperature for every population
	historicalMeans = c();
	for (pop in 0:(numPops - 1))
	{
		popHistoricalMean = mean(climateMatrix[historicalRows, pop]);
		historicalMeans = c(historicalMeans, popHistoricalMean);
	}
	
	defineConstant("historicalMeanClimate", historicalMeans);
	
	// The shared baseline is calculated from all population historical means.
	// It will change automatically if the climate matrix contains different populations.
	defineConstant("baselinePhenotype", mean(historicalMeanClimate));
	
	defineConstant("observedClimateRows", observedRows);
	defineConstant("numObservedYears", size(observedRows));
	defineConstant("Tend", TclimateChange + numObservedYears - 1);
	
	catn("Shared baseline thermal phenotype: " + baselinePhenotype + " degrees C.");
	
	for (pop in 0:(numPops - 1))
		catn("p" + pop + " 1940-1970 mean: " +
			historicalMeanClimate[pop] + " degrees C.");
	
	// Genetics
	initializeMutationRate(1e-7);
	initializeRecombinationRate(1e-8);
	
	initializeMutationType("m1", 0.5, "f", 0.0); // neutral mutations
	initializeMutationType("m2", 0.5, "f", 0.0); // warm phenotype mutations
	initializeMutationType("m3", 0.5, "f", 0.0); // cold phenotype mutations
	
	// Fixed phenotype mutations must remain on the genomes so they remain
	// part of the mutation-count phenotype.
	m2.convertToSubstitution = F;
	m3.convertToSubstitution = F;
	m2.color = "red";
	m3.color = "blue";
	
	// Keep the same total proportion of phenotype mutations as V1:
	// 0.5% warm mutations and 0.5% cold mutations.
	initializeGenomicElementType("g1", c(m1, m2, m3),
		c(0.99, 0.005, 0.005));
	initializeGenomicElement(g1, 0, 99999);
}


// Each individual produces a random number of offspring
reproduction()
{
	litterSize = rpois(1, R);
	
	for (offspring in seqLen(litterSize))
	{
		mate = subpop.sampleIndividuals(1, exclude=individual);
		
		if (mate.size() > 0)
			subpop.addCrossed(individual, mate);
	}
}


// Create the starting populations
1 early()
{
	for (pop in 0:(numPops - 1))
		sim.addSubpop("p" + pop, K);
}


// Demography, migration, climate selection and density regulation
1:Tend early()
{
	///// NON-OVERLAPPING GENERATIONS
	allIndividuals = sim.subpopulations.individuals;
	adults = allIndividuals[allIndividuals.age > 0];
	
	if (size(adults) > 0)
		sim.killIndividuals(adults);
	
	
	///// MIGRATION
	// First choose every migrant without moving anyone
	allMigrants = c();
	allDestinations = c();
	
	for (sourcePop in 0:(numPops - 1))
	{
		sourceSubpop = sim.subpopulations[sourcePop];
		
		if (sourceSubpop.individualCount == 0)
			next;
		
		migrationRates = drop(migrationMatrix[sourcePop,]);
		migrationRates[sourcePop] = 0.0;
		totalMigrationRate = sum(migrationRates);
		
		if (totalMigrationRate > 1.0)
			stop("Migration rates leaving a population cannot sum above 1.");
		
		if (totalMigrationRate == 0.0)
			next;
		
		numMigrants = rbinom(1, sourceSubpop.individualCount,
			totalMigrationRate);
		
		if (numMigrants == 0)
			next;
		
		popMigrants = sample(sourceSubpop.individuals, numMigrants);
		popDestinations = sample(0:(numPops - 1), numMigrants,
			replace=T, weights=migrationRates);
		
		allMigrants = c(allMigrants, popMigrants);
		allDestinations = c(allDestinations, popDestinations);
	}
	
	// Move the migrants after every migration choice has been made
	if (size(allMigrants) > 0)
	{
		for (destinationPop in 0:(numPops - 1))
		{
			migrants = allMigrants[allDestinations == destinationPop];
			
			if (size(migrants) > 0)
				sim.subpopulations[destinationPop].takeMigrants(migrants);
		}
	}
	
	
	///// CURRENT CLIMATE
	// Phase 1: ticks 1-2000 move from the shared baseline to each
	// population's own historical mean.
	if (sim.cycle <= TlocalAdaptation)
	{
		adaptProgress = asFloat(sim.cycle - 1) /
			(TlocalAdaptation - 1);
		
		climates = baselinePhenotype +
			(historicalMeanClimate - baselinePhenotype) * adaptProgress;
		
		currentYear = "Local Adaptation";
	}
	
	// Phase 2: ticks 2001-3999 remain at each historical mean.
	else if (sim.cycle < TclimateChange)
	{
		climates = historicalMeanClimate;
		currentYear = "Historical Mean";
	}
	
	// Phase 3: tick 4000 begins the observed climate record with 1970.
	else
	{
		climateYearIndex = sim.cycle - TclimateChange;
		
		if (climateYearIndex >= numObservedYears)
			climateYearIndex = numObservedYears - 1;
		
		climateRow = observedClimateRows[climateYearIndex];
		climates = drop(climateMatrix[climateRow,]);
		currentYear = asString(climateYears[climateRow]);
	}
	
	
	///// PHENOTYPE AND CLIMATE FITNESS
	for (subpop in sim.subpopulations)
	{
		if (subpop.individualCount == 0)
			next;
		
		inds = subpop.individuals;
		climate = climates[subpop.id];
		
		warmMutations = asFloat(inds.countOfMutationsOfType(m2));
		coldMutations = asFloat(inds.countOfMutationsOfType(m3));
		
		breedingValues = (warmMutations - coldMutations) *
			effectPerMutation;
		phenotypes = baselinePhenotype + breedingValues;
		
		fitness = 1.0 -
			(phenotypes - climate)^2 * selectionStrength;
		fitness[fitness < 0.0] = 0.0;
		
		inds.fitnessScaling = fitness;
		inds.tagF = phenotypes;
	}
	
	
	///// DENSITY REGULATION
	for (subpop in sim.subpopulations)
	{
		if (subpop.individualCount > 0)
			subpop.fitnessScaling =
				min(K / subpop.individualCount, 1.5);
	}
	
	// Save climate values for the output event
	sim.setValue("currentClimates", climates);
	sim.setValue("currentClimateYear", currentYear);
}


// Print results and stop if every population is extinct
1:Tend late()
{
	totalPopulationSize = sum(sim.subpopulations.individualCount);
	
	if (totalPopulationSize == 0)
	{
		catn("All populations extinct at tick " + sim.cycle + ".");
		sim.simulationFinished();
	}
	else
	{
		outputThisGeneration = F;
		
		if (sim.cycle % 100 == 0)
			outputThisGeneration = T;
		
		if (sim.cycle >= TclimateChange)
			outputThisGeneration = T;
		
		if (outputThisGeneration)
		{
			climates = sim.getValue("currentClimates");
			currentYear = sim.getValue("currentClimateYear");
			
			for (subpop in sim.subpopulations)
			{
				if (subpop.individualCount == 0)
				{
					catn("Tick " + sim.cycle + " | Year: " +
						currentYear + " | p" + subpop.id + " : 0" +
						" | Current phenotype : NA" +
						" | Current Temp : " +
						climates[subpop.id] + " |");
				}
				else
				{
					phenotypes = subpop.individuals.tagF;
					meanPhenotype = mean(phenotypes);
					
					catn("Tick " + sim.cycle + " | Year: " +
						currentYear + " | p" + subpop.id + " : " +
						subpop.individualCount +
						" | Current mean phenotype : " +
						meanPhenotype + " | Current Temp : " +
						climates[subpop.id] + " |");
				}
			}
		}
	}
}


// Finish after the final observed climate year
Tend late()
{
	sim.simulationFinished();
}
