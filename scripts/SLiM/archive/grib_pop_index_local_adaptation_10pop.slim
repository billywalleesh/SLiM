initialize() {
	initializeSLiMModelType("nonWF"); // set non-WF model
	
	defineConstant("migrationInputDirectory", "C:/Users/WilliamWallisch/msc_workspace/SLiM/input/grib_pop_index_local_adaptation/migration_matrix/");
	defineConstant("climateInputDirectory", "C:/Users/WilliamWallisch/msc_workspace/SLiM/input/grib_pop_index_local_adaptation/climate_matrix/");
	// Migration CSV must be square: one row and one column per population
	defineConstant("migrationFile", migrationInputDirectory + "grib_migration_matrix_10pop.csv");
	// Climate CSV must have one column for each population in the migration CSV.
	// Rows are climate years from the GRIB-derived climate shift matrix.
	defineConstant("climateFile", climateInputDirectory + "grib_climate_matrix_10pop.csv");
	defineConstant("climateYearsFile", climateInputDirectory + "grib_climate_years_10pop.csv");
	
	migrationTable = readCSV(migrationFile, colNames=F);
	climateTable = readCSV(climateFile, colNames=F);
	climateYearsTable = readCSV(climateYearsFile, colNames=F);
	
	migrationInput = migrationTable.asMatrix();
	//print(migrationInput);//show the matrix
	climateInput = climateTable.asMatrix();
	//print(climateInput);//show the matrix
	climateYearsInput = asInteger(drop(climateYearsTable.asMatrix()));
	
	defineConstant("numPops", nrow(migrationInput)); // number of subpopulations
	defineConstant("M", migrationInput); // migration rates: rows are source pops, columns are destination pops
	
	if (nrow(migrationInput) != ncol(migrationInput))
		stop("Migration matrix must be square: one row and one column per population.");
	
	if (ncol(climateInput) != numPops)
		stop("Climate matrix must have one column for each population in the migration matrix.");
	
	if (size(climateYearsInput) != nrow(climateInput))
		stop("Climate years file must have one year for each row of the climate matrix.");
	
	///// MIGRATION PAIR LIST
	// Index migration matrix into list of migration pairs.
	// 3-pop matrix, the first migration pairs are:
	// migration pair 0: p0 sends migrants to p1 at rate 0.005
	// migration pair 1: p0 sends migrants to p2 at rate 0.001
	// migration pair 2: p1 sends migrants to p0 at rate 0.005 etc...
	t_migrationPairSourcePop = c(); //temporary vectors
	t_migrationPairDestinationPop = c();
	t_migrationPairRate = c();
	
	//loop feeds the t_ vectors based on number of pops in csv input 
	//for each source pop
	for (sourcePop in 0:(numPops - 1))
	{
		//take each dest pop
		for (destPop in 0:(numPops - 1))
		{
			//if they are the same skip
			if (sourcePop == destPop)
				next;
			
			//rate is row and column of csv file 
			migrationRate = M[sourcePop, destPop];
			
			//skip rate 0
			if (migrationRate == 0.0)
				next;
			
			// Save one migration pair: source population, destination population, and rate.
			t_migrationPairSourcePop = c(t_migrationPairSourcePop, sourcePop);
			t_migrationPairDestinationPop = c(t_migrationPairDestinationPop, destPop);
			t_migrationPairRate = c(t_migrationPairRate, migrationRate);
		}
	}
	
	//using these now full vectors we define the constants for each
	defineConstant("migrationPairSourcePop", t_migrationPairSourcePop); //print(migrationPairSourcePop) = 0 0 1 1 2 2
	defineConstant("migrationPairDestinationPop", t_migrationPairDestinationPop); //print(migrationPairDestinationPop)= 1 2 0 2 0 1
	defineConstant("migrationPairRate", t_migrationPairRate); //print(migrationPairRate) = 0.005 0.001 0.005 0.005 0.001 0.005
	defineConstant("numMigrationPairs", size(t_migrationPairRate)); //number of pairs present
	
	///// CLIMATE SHIFT MATRIX
	// climateMatrix values are temperature shifts from each population's own historical baseline.
	// Negative values are colder-than-baseline years; positive values are warmer-than-baseline years.
	defineConstant("climateMatrix", climateInput);
	defineConstant("climateYears", climateYearsInput);
	
	defineConstant("TlocalAdaptation", 2000); // climate selection begins
	defineConstant("TclimateChange", 4000); // annual climate rows begin
	defineConstant("Tend", 6000);
	
	defineConstant("historicalClimateStartYear", 1940);
	defineConstant("historicalClimateEndYear", 1970);
	defineConstant("climateChangeStartYear", 1970);
	
	t_historicalClimateRows = which((climateYears >= historicalClimateStartYear) & (climateYears <= historicalClimateEndYear));
	t_climateChangeRows = which(climateYears >= climateChangeStartYear);
	
	if (size(t_historicalClimateRows) == 0)
		stop("No climate rows found for the historical climate period.");
	
	if (size(t_climateChangeRows) == 0)
		stop("No climate rows found for the climate-change period.");
	
	t_historicalMeanClimate = c();
	for (pop in 0:(numPops - 1))
		t_historicalMeanClimate = c(t_historicalMeanClimate, mean(climateMatrix[t_historicalClimateRows, pop]));
	
	defineConstant("historicalMeanClimate", t_historicalMeanClimate);
	defineConstant("climateChangeRows", t_climateChangeRows);
	defineConstant("numClimateChangeRows", size(t_climateChangeRows));
	
	catn("Historical climate period: " + historicalClimateStartYear + "-" + historicalClimateEndYear + " mean.");
	catn("Climate-change period starts at year " + climateChangeStartYear + " and runs to " + climateYears[size(climateYears) - 1] + ".");
	
	initializeMutationRate(1e-7); // set standard mutation rate
	initializeRecombinationRate(1e-8); // set standard recombination rate
	initializeMutationType("m1", 0.5, "f", 0.0); // set neutral mutations
	initializeMutationType("m2", 0.5, "f", 0.0); // set mutations that will have an effect (defined here as neutral, but we'll add a phenotypic effect below). 
	m2.color = "red"; // will be displayed in red in the output
	initializeGenomicElementType("g1", c(m1,m2), c(0.99,0.01)); // set relative frequency: m2 is 1% of all mutations
	initializeGenomicElement(g1, 0, 99999); // set genome size
}

// Set reproduction behavior: every individual gets a number of offspring from a poisson distriubtion of mean R. 
reproduction() {
	R = 1.01; // on average every individual 1.01 offspring
	
	// individuals reproduce locally, without dispersal
	litterSize = rpois(1, R);
	
	for (i in seqLen(litterSize))
	{
		// generate each offspring with an independently drawn mate
		mate = subpop.sampleIndividuals(1, exclude=individual);
		if (mate.size())
			subpop.addCrossed(individual, mate);
	}
}

// set size of sub pop at start: e.g. 200 in each 
1 early() {
	for (i in 1:(numPops))
		sim.addSubpop("p" + (i-1), 200);
}


// Set ageing, migration and survival 
1:6000 early() {
	K=5000; // carrying capacity per sub-pop
	
	// AGE MORTALITY
	// non-overlapping generations; kill off the parental generation
	inds = sim.subpopulations.individuals; // get all the individuals
	adults = inds[inds.age > 0];
	
	if (size(adults) > 0)
		sim.killIndividuals(adults);
	
	///// MIGRATION
	// First choose migrants, then move them. This prevents an individual from migrating twice.
	allMigrants = c(); //empty vector that will store all migrants each generation
	allDestinations = c(); //empty vector that will store all destinations
	
	// Each source population draws its total number of migrants once.
	// Then those migrants are assigned to destinations using that source population's migration pairs.
	subpops = sim.subpopulations;
	
	for (sourcePop in 0:(numPops - 1))
	{
		// sourcePop is the matrix/index number; sourceSubpop is the actual SLiM population object.
		// Example: if sourcePop = 0, then sourceSubpop = p0.
		sourceSubpop = subpops[sourcePop];
		
		if (sourceSubpop.individualCount == 0)
			next;
		
		// Find the migration pairs that start from this source population.
		// In the 3-pop example, if sourcePop = 0, this returns migration pair 0 and migration pair 1:
		// migration pair 0 = p0 -> p1, migration pair 1 = p0 -> p2.
		popMigrationPairs = which(migrationPairSourcePop == sourcePop);
		
		if (size(popMigrationPairs) == 0)
			next;
		
		// These vectors describe where migrants from this source population can go.
		// For sourcePop = 0 in the 3-pop example:
		// possibleDestinations = c(1, 2), meaning migrants can go to p1 or p2.
		// migrationRates = c(0.005, 0.001), meaning p1 is more likely than p2.
		possibleDestinations = migrationPairDestinationPop[popMigrationPairs];
		migrationRates = migrationPairRate[popMigrationPairs];
		
		// Total probability that an individual leaves this source population at all.
		// For p0 in the 3-pop example: 0.005 + 0.001 = 0.006.
		totalMigrationRate = sum(migrationRates);
		
		if (totalMigrationRate > 1.0)
			stop("Total migration rate from source population p" + sourcePop + " is greater than 1.0.");
		
		if (totalMigrationRate == 0.0)
			next;
		
		// Draw how many individuals leave this source population.
		// If p0 has 5000 individuals and totalMigrationRate = 0.006,
		// then the expected number of migrants is about 5000 * 0.006 = 30.
		numMigrants = rbinom(1, sourceSubpop.individualCount, totalMigrationRate);
		
		if (numMigrants == 0)
			next;
		
		// Choose the migrants, then assign each migrant to a destination.
		// popMigrants are the actual individuals that leave the source population.
		// popDestinations stores where each of those migrants will go.
		popMigrants = sample(sourceSubpop.individuals, numMigrants);
		// For p0 in the 3-pop example, destinations are sampled from c(1, 2)
		// with weights c(0.005, 0.001). So about 83% go to p1 and 17% go to p2.
		popDestinations = sample(possibleDestinations, numMigrants, replace=T, weights=migrationRates);
		
		// Add this source population's migrants to the generation-wide migration list.
		allMigrants = c(allMigrants, popMigrants);
		allDestinations = c(allDestinations, popDestinations);
	}
	
	// After all migration decisions are made, move migrants into their destination populations.
	if (size(allMigrants) > 0)
	{
		for (destPop in 0:(numPops - 1))
		{
			//when destSubpop = 1, it moves B and D to p1. When destSubpop = 2, it moves A to p2.
			//allDestinations = [1, 1, 2]
			//ex: when allDestinations == 1 and destPop = 1 we see [true, true, false]
			migrants = allMigrants[allDestinations == destPop];
			
			if (size(migrants) > 0)
				//ex : subpops[1].takeMigrants(c(B, D));
				//ex : subpops[2].takeMigrants(A);
				subpops[destPop].takeMigrants(migrants);
		}
	}
	
	// Climate selection after migration; migrants experience the climate of their destination.
	if (sim.cycle >= TlocalAdaptation)
	{
		if (sim.cycle < TclimateChange)
		{
			// From generation 2000 to 3999, use the mean 1940-1970 climate shift for each population.
			climates = historicalMeanClimate;
		}
		else
		{
			// From generation 4000 onward, move through the annual rows for 1970-2026.
			// After 2026, keep using the final observed row.
			climateStep = sim.cycle - TclimateChange;
			
			if (climateStep >= numClimateChangeRows)
				climateStep = numClimateChangeRows - 1;
			
			climateRow = climateChangeRows[climateStep];
			climates = drop(climateMatrix[climateRow,]);
		}
		
		for (subpop in sim.subpopulations)
		{
			if (subpop.individualCount == 0)
				next;
			
			inds = subpop.individuals;
			climate = climates[subpop.id]; // p0 = climates[0], p1 = climates[1], p2 = climates[2]...
			
			phenotypes = asFloat(inds.countOfMutationsOfType(m2));
			fitness = 1.0 - (phenotypes - climate)^2 * 0.05;
			fitness[fitness < 0.0] = 0.0;
			
			inds.fitnessScaling = fitness;
			inds.tagF = phenotypes;
		}
	}
	
	// post-migration density-dependent fitness for each subpop
	for (subpop in sim.subpopulations)
	{
		if (subpop.individualCount > 0)
			subpop.fitnessScaling = K / subpop.individualCount; // set fitness based on the maximal capacity of the sub-population (K)
	}
}

///// FIRST PHASE: nothing happens
// Before TlocalAdaptation: all mutations build up as neutral, there is no climate selection in any population.



///// SECOND PHASE: historical local adaptation
// From TlocalAdaptation to TclimateChange: populations adapt to the mean climate shift from 1940-1970.
// This gives each population a stable historical climate before annual climate change begins.



///// THIRD PHASE: annual climate change
// From TclimateChange onward: the model reads annual climate rows from 1970-2026.
// After the final 2026 row, the model keeps using the final row.


// Expected behavior: check population sizes and fitness over time. 
// Before TlocalAdaptation: pop size gets rapidly to maximum capacity. Fitness is 1 in all individuals because there is no climate selection.
// At TlocalAdaptation: selection kicks in using the 1940-1970 mean climate shift.
// At TclimateChange: annual climate rows begin, starting with 1970.

Tend late() {
	sim.simulationFinished();
}

