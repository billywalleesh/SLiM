// Local adaptation to observed Swiss temperatures -- POLYGENIC VERSION
// Neutral burn-in, abrupt historical selection, observed climate, then a 2025 hold.
// Temperature is converted to an optimal phenotype value, built additively from
// many small-effect m2 mutations (a normal DFE) rather than a simple allele count.
//
// Also logs demographic (variance) effective population size per population,
// using the Crow & Denniston form
//
//    Ne = (N * kBar - 2) / (kBar - 1 + Vk / kBar)
//
// where N is the number of PARENTS in a cohort, kBar is their mean number of
// SURVIVING offspring and Vk is the variance of that number. Counting
// survivors rather than births matters: litter size here is Poisson, so a
// births-based Vk is pinned near 2.0 no matter what the climate does, and the
// resulting Ne is just a restatement of census size. Survivors carry the
// effect of viability selection, which is the part that actually erodes
// diversity.
//
// Because an offspring's survival is only known after selection at the end of
// its birth tick, Ne is necessarily ONE TICK BEHIND: the value printed at tick
// T describes the cohort that reproduced at tick T-1. The printed line
// therefore carries its own parent count ("Ne parents"), so Ne and N on the
// same line always refer to the same cohort. Do not compare Ne to the census
// count printed beside it.

function (float) temperatureToAlleleOptimum(float temperatures)
{
	return startAlleleOptimum +
		(temperatures - startTemperature) *
		(endAlleleOptimum - startAlleleOptimum) /
		(endTemperature - startTemperature);
}


initialize()
{
	initializeSLiMModelType("nonWF");

	// Pedigree tracking is required so that surviving offspring can be
	// attributed back to their parents in the Ne calculation.
	initializeSLiMOptions(keepPedigrees=T);

	// Input files
	defineConstant("inputDirectory", "C:/Users/WilliamWallisch/msc_workspace/SLiM/input/grib_pop_index_local_adaptation/");
	defineConstant("migrationFile", inputDirectory + "migration_matrix/grib_migration_matrix_4pop_decay.csv");
	defineConstant("climateFile", inputDirectory + "climate_matrix/grib_climate_matrix_4pop_degrees_c_1940_2025.csv");
	defineConstant("yearFile", inputDirectory + "climate_matrix/grib_climate_years_4pop_1940_2025.csv");

	// Read the migration data
	migrationTable = readCSV(migrationFile, colNames=F);
	migrationInput = migrationTable.asMatrix();
	print(migrationInput);

	// Read the climate data
	climateTable = readCSV(climateFile, colNames=F);
	climateInput = climateTable.asMatrix();
	print(climateInput);

	// Read the climate years
	yearTable = readCSV(yearFile, colNames=F);
	yearMatrix = yearTable.asMatrix();
	yearInput = asInteger(drop(yearMatrix));

	// Main model parameters
	defineConstant("numPops", nrow(migrationInput));
	defineConstant("migrationMatrix", migrationInput);
	defineConstant("climateMatrix", climateInput);
	defineConstant("climateYears", yearInput);
	defineConstant("K", 500);
	defineConstant("R", 1.01);
	defineConstant("selectionStrength", 0.05);
	defineConstant("TlocalAdaptation", 2000);
	defineConstant("TclimateChange", 4000);
	defineConstant("TholdAfterObserved", 0);

	// Standard deviation of the per-copy QTL effect size distribution for
	// the polygenic m2 mutations (mean effect is 0; effects sum additively).
	defineConstant("m2EffectSD", 0.1);

	// Find the historical years and observed climate years
	historicalRows = which((climateYears >= 1940) & (climateYears <= 1970));
	observedRows = which(climateYears >= 1970);

	// Calculate the historical mean temperature for every population
	historicalMeans = apply(climateMatrix[historicalRows, ], 1,
		"mean(applyValue);");

	defineConstant("historicalMeanClimate", historicalMeans);
	defineConstant("observedClimateRows", observedRows);
	defineConstant("numObservedYears", size(observedRows));
	defineConstant("TlastObserved",
		TclimateChange + numObservedYears - 1);
	defineConstant("Tend", TlastObserved + TholdAfterObserved);

	// Shared temperature-to-phenotype scale:
	// p1's historical mean is optimal for a phenotype of 2;
	// p0's temperature in the final observed year is optimal for a phenotype of 6.
	finalObservedRow = observedClimateRows[numObservedYears - 1];
	defineConstant("startTemperature", historicalMeanClimate[1]);
	defineConstant("endTemperature", climateMatrix[finalObservedRow, 0]);
	defineConstant("startAlleleOptimum", 2.0);
	defineConstant("endAlleleOptimum", 6.0);

	if (endTemperature <= startTemperature)
		stop("End temperature must be above start temperature.");

	catn("Temperature-to-phenotype scale:");
	catn(startTemperature + " degrees C = " +
		startAlleleOptimum + " optimal phenotype.");
	catn(endTemperature + " degrees C = " +
		endAlleleOptimum + " optimal phenotype.");

	for (pop in 0:(numPops - 1))
	{
		historicalOptimum =
			temperatureToAlleleOptimum(historicalMeanClimate[pop]);
		finalOptimum =
			temperatureToAlleleOptimum(climateMatrix[finalObservedRow, pop]);

		catn("p" + pop +
			" | Historical mean temperature: " +
			historicalMeanClimate[pop] +
			" | Historical phenotype optimum: " +
			historicalOptimum +
			" | Final temperature: " +
			climateMatrix[finalObservedRow, pop] +
			" | Final phenotype optimum: " +
			finalOptimum + ".");
	}

	// Genetics
	initializeMutationRate(1e-7);

	// Recombination. The element is 100 kb, so the total map length is
	// 100000 * rate crossovers per gamete. The oligogenic model used 1e-8,
	// which is 0.001 crossovers per gamete: effectively a single
	// non-recombining block. That is harmless when a handful of
	// interchangeable alleles carry the trait, but a polygenic trait needs
	// recombination to shuffle its loci, otherwise selection can only choose
	// between whole haplotypes and most of the additive variance is lost to
	// interference. 1e-5 gives about one crossover per gamete, i.e. treats
	// the element as one ordinary chromosome.
	initializeRecombinationRate(1e-5);

	initializeMutationType("m1", 0.5, "f", 0.0);
	initializeMutationType("m2", 0.5, "n", 0.0, m2EffectSD);
	m2.convertToSubstitution = F;
	m2.color = "red";

	// Mutational target for the trait. At the oligogenic model's 0.01, m2
	// mutations arrive at 1e-7 * 100000 * 0.01 = 1e-4 per gamete, so theta =
	// 4*N*mu = 2 and an individual carries only about four m2 copies. A
	// phenotype summed from four draws of N(0, 0.1) has a standard deviation
	// near 0.2 and can never reach optima of 2 to 6. At 0.5 the rate is
	// 5e-3 per gamete, giving an equilibrium additive variance near 1.0,
	// which is the right scale for the optima this model uses.
	initializeGenomicElementType("g1", c(m1, m2), c(0.5, 0.5));
	initializeGenomicElement(g1, 0, 99999);
}


// m2's own selection coefficient is a QTL effect size, not a direct fitness
// effect -- neutralize SLiM's built-in fitness effect here so selection acts
// only through the optimum-tracking climate fitness computed below.
mutationEffect(m2)
{
	return 1.0;
}


// Each individual produces a random number of offspring
reproduction()
{
	litterSize = rpois(1, R);

	for (offspring in seqLen(litterSize))
	{
		mate = subpop.sampleIndividuals(1, exclude=individual);

		if (mate.size() > 0)
			subpop.addCrossed(individual, mate);
	}
}


// Create the starting populations
1 early()
{
	for (pop in 0:(numPops - 1))
		sim.addSubpop("p" + pop, K);
}


// Demography, migration, climate selection and density regulation
1:Tend early()
{
	///// NON-OVERLAPPING GENERATIONS
	allIndividuals = sim.subpopulations.individuals;
	adults = allIndividuals[allIndividuals.age > 0];


	///// EFFECTIVE POPULATION SIZE (Ne)
	// The adults alive here are the offspring of the PREVIOUS cohort that
	// have survived viability selection. Counting how many of them each
	// previous-cohort parent produced gives the variance in realized
	// reproductive success, including everything selection and density
	// regulation did to the offspring. Ne therefore describes the cohort
	// that reproduced one tick ago, and is reported with its own parent
	// count so the two are always comparable.
	neEstimates = rep(NAN, numPops);
	neParentCounts = rep(0, numPops);
	neMeanOffspring = rep(NAN, numPops);
	neVarOffspring = rep(NAN, numPops);

	previousParentIDs = sim.getValue("previousParentIDs");
	previousParentPops = sim.getValue("previousParentPops");

	if (!isNULL(previousParentIDs))
	{
		if ((size(previousParentIDs) > 0) & (size(adults) > 0))
		{
			// Each surviving adult names two parents from the previous cohort.
			childParentIDs = adults.pedigreeParentIDs;

			minParentID = min(previousParentIDs);
			maxParentID = max(previousParentIDs);

			// Shift IDs down so they can be used as tabulate() bins.
			shiftedIDs = childParentIDs - minParentID;
			shiftedIDs = shiftedIDs[(shiftedIDs >= 0) &
				(shiftedIDs <= (maxParentID - minParentID))];

			offspringPerBin = tabulate(shiftedIDs,
				maxbin=(maxParentID - minParentID));

			// Surviving offspring produced by each previous-cohort parent.
			parentOffspring = offspringPerBin[previousParentIDs - minParentID];

			for (pop in 0:(numPops - 1))
			{
				popOffspring = asFloat(parentOffspring[previousParentPops == pop]);
				nParents = size(popOffspring);
				neParentCounts[pop] = nParents;

				if (nParents > 1)
				{
					kBar = mean(popOffspring);
					Vk = var(popOffspring);

					neMeanOffspring[pop] = kBar;
					neVarOffspring[pop] = Vk;

					// Crow & Denniston variance effective size. The
					// denominator can go non-positive when a cohort barely
					// replaces itself, in which case Ne is undefined rather
					// than merely large.
					if (kBar > 0.0)
					{
						denominator = kBar - 1 + Vk / kBar;

						if (denominator > 0.0)
							neEstimates[pop] =
								(nParents * kBar - 2) / denominator;
					}
				}
			}
		}
	}

	sim.setValue("currentNe", neEstimates);
	sim.setValue("currentNeParents", neParentCounts);
	sim.setValue("currentNeMeanOffspring", neMeanOffspring);
	sim.setValue("currentNeVarOffspring", neVarOffspring);

	// Remember this tick's reproducing cohort, and the subpopulation each
	// member reproduced in, for the next tick's calculation.
	sim.setValue("previousParentIDs", adults.pedigreeID);
	sim.setValue("previousParentPops", adults.subpopulation.id);


	if (size(adults) > 0)
		sim.killIndividuals(adults);


	///// MIGRATION
	// First choose every migrant without moving anyone
	allMigrants = c();
	allDestinations = c();

	for (sourcePop in 0:(numPops - 1))
	{
		sourceSubpop = sim.subpopulations[sourcePop];

		if (sourceSubpop.individualCount == 0)
			next;

		migrationRates = drop(migrationMatrix[sourcePop,]);
		migrationRates[sourcePop] = 0.0;
		totalMigrationRate = sum(migrationRates);

		if (totalMigrationRate > 1.0)
			stop("Migration rate above 1.");

		if (totalMigrationRate == 0.0)
			next;

		numMigrants = rbinom(1, sourceSubpop.individualCount,
			totalMigrationRate);

		if (numMigrants == 0)
			next;

		popMigrants = sample(sourceSubpop.individuals, numMigrants);
		popDestinations = sample(0:(numPops - 1), numMigrants,
			replace=T, weights=migrationRates);

		allMigrants = c(allMigrants, popMigrants);
		allDestinations = c(allDestinations, popDestinations);
	}

	// Move migrants after every migration choice has been made
	if (size(allMigrants) > 0)
	{
		for (destinationPop in 0:(numPops - 1))
		{
			migrants = allMigrants[allDestinations == destinationPop];

			if (size(migrants) > 0)
				sim.subpopulations[destinationPop].takeMigrants(migrants);
		}
	}


	///// CURRENT TEMPERATURE AND ALLELE OPTIMUM
	// Phase 1: ticks 1-1999 are a neutral burn-in
	if (sim.cycle < TlocalAdaptation)
	{
		temperatures = historicalMeanClimate;
		alleleOptima = temperatureToAlleleOptimum(temperatures);
		currentYear = "Neutral Burn-in";
		selectionActive = F;
	}

	// Phase 2: tick 2000 abruptly imposes the historical optima
	else if (sim.cycle < TclimateChange)
	{
		temperatures = historicalMeanClimate;
		alleleOptima = temperatureToAlleleOptimum(temperatures);
		currentYear = "Historical Mean";
		selectionActive = T;
	}

	// Phase 3: tick 4000 begins the observed 1970-2025 record
	else if (sim.cycle <= TlastObserved)
	{
		climateYearIndex = sim.cycle - TclimateChange;
		climateRow = observedClimateRows[climateYearIndex];

		temperatures = drop(climateMatrix[climateRow,]);
		alleleOptima = temperatureToAlleleOptimum(temperatures);
		currentYear = asString(climateYears[climateRow]);
		selectionActive = T;
	}

	// Phase 4: hold the final 2025 conditions for 2,000 ticks
	else
	{
		finalObservedRow = observedClimateRows[numObservedYears - 1];
		temperatures = drop(climateMatrix[finalObservedRow,]);
		alleleOptima = temperatureToAlleleOptimum(temperatures);
		currentYear = "2025 Hold";
		selectionActive = T;
	}


	///// CLIMATE FITNESS
	inds = sim.subpopulations.individuals;

	if (size(inds) > 0)
	{
		phenotypes = inds.sumOfMutationsOfType(m2);
		inds.tagF = phenotypes;

		if (selectionActive)
		{
			popOptima = alleleOptima[inds.subpopulation.id];
			fitness = 1.0 -
				(phenotypes - popOptima)^2 * selectionStrength;
			fitness[fitness < 0.0] = 0.0;
			inds.fitnessScaling = fitness;
		}
	}


	///// DENSITY REGULATION
	for (subpop in sim.subpopulations)
	{
		if (subpop.individualCount > 0)
			subpop.fitnessScaling =
				min(K / subpop.individualCount, 1.5);
	}

	sim.setValue("currentTemperatures", temperatures);
	sim.setValue("currentAlleleOptima", alleleOptima);
	sim.setValue("currentClimateYear", currentYear);
	sim.setValue("selectionActive", selectionActive);
}


// Print results and stop if every population is extinct
1:Tend late()
{
	totalPopulationSize = sum(sim.subpopulations.individualCount);

	if (totalPopulationSize == 0)
	{
		catn("All populations extinct at tick " + sim.cycle + ".");
		sim.simulationFinished();
	}
	else
	{
		outputThisGeneration = F;

		if (sim.cycle % 100 == 0)
			outputThisGeneration = T;

		// Report every observed year, but only every 100 ticks
		// during the long post-2025 hold.
		if ((sim.cycle >= TclimateChange) &
			(sim.cycle <= TlastObserved))
			outputThisGeneration = T;

		if (outputThisGeneration)
		{
			temperatures = sim.getValue("currentTemperatures");
			alleleOptima = sim.getValue("currentAlleleOptima");
			currentYear = sim.getValue("currentClimateYear");
			selectionActive = sim.getValue("selectionActive");
			neEstimates = sim.getValue("currentNe");
			neParentCounts = sim.getValue("currentNeParents");
			neMeanOffspring = sim.getValue("currentNeMeanOffspring");
			neVarOffspring = sim.getValue("currentNeVarOffspring");

			for (subpop in sim.subpopulations)
			{
				// Ne and its parent count describe the cohort that
				// reproduced one tick ago, not the census printed here.
				neReport = " | Ne : " + neEstimates[subpop.id] +
					" | Ne parents : " + neParentCounts[subpop.id] +
					" | Ne kBar : " + neMeanOffspring[subpop.id] +
					" | Ne Vk : " + neVarOffspring[subpop.id] + " |";

				if (subpop.individualCount == 0)
				{
					catn("Tick " + sim.cycle +
						" | Year: " + currentYear +
						" | Selection active: " + selectionActive +
						" | p" + subpop.id + " : 0" +
						" | Current mean phenotype : NA" +
						" | Current Temp : " +
						temperatures[subpop.id] +
						" | Allele optimum : " +
						alleleOptima[subpop.id] +
						neReport);
				}
				else
				{
					phenotypes = subpop.individuals.tagF;

					catn("Tick " + sim.cycle +
						" | Year: " + currentYear +
						" | Selection active: " + selectionActive +
						" | p" + subpop.id + " : " +
						subpop.individualCount +
						" | Current mean phenotype : " +
						mean(phenotypes) +
						" | Current Temp : " +
						temperatures[subpop.id] +
						" | Allele optimum : " +
						alleleOptima[subpop.id] +
						neReport);
				}
			}
		}
	}
}


// Finish after the 2,000-tick hold at the final observed climate
Tend late()
{
	sim.simulationFinished();
}
