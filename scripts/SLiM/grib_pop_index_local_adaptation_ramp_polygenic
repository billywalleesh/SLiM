// Local adaptation to observed Swiss temperatures - POLYGENIC architecture
// An individual's phenotype is the number of m2 mutations it carries
//
// Sibling script of grib_pop_index_local_adaptation_ramp_oligogenic.
// The two scripts are identical except for the three architecture
// constants below:
//   startAlleleOptimum / endAlleleOptimum : the allele-copy scale
//     (20-100 here, 2-10 in the oligogenic sibling), so one allele moves
//     the phenotype a small step (polygenic) or a large step (oligogenic)
//   m2Proportion : the share of the genome that is climate-QTL sequence,
//     i.e. the mutational target (many loci here, few in the sibling)
// Selection is defined per squared degree C of mismatch and converted to
// per squared copy automatically, so selection on the TRAIT is identical
// in both siblings regardless of the allele scale.
//
// Temperature-to-allele scale (anchors computed from the data):
//   lowest 1940-1970 mean baseline temp     -> startAlleleOptimum copies
//   highest temp in the final observed year -> endAlleleOptimum copies

function (float) temperatureToAlleleOptimum(float temperatures)
{
	return startAlleleOptimum +
		(temperatures - startTemperature) *
		(endAlleleOptimum - startAlleleOptimum) /
		(endTemperature - startTemperature);
}


initialize(){
	initializeSLiMModelType("nonWF");

	// Input files
	defineConstant("inputDirectory", "C:/Users/WilliamWallisch/msc_workspace/SLiM/input/grib_pop_index_local_adaptation/");
	defineConstant("migrationFile", inputDirectory + "migration_matrix/grib_migration_matrix_4pop_decay.csv");
	defineConstant("climateFile", inputDirectory + "climate_matrix/grib_climate_matrix_4pop_degrees_c_1940_2025.csv");
	defineConstant("yearFile", inputDirectory + "climate_matrix/grib_climate_years_4pop_1940_2025.csv");

	// Read the migration data
	migrationTable = readCSV(migrationFile, colNames=F);
	migrationInput = migrationTable.asMatrix();
	print(migrationInput);//show the matrix

	// Read the climate data
	climateTable = readCSV(climateFile, colNames=F);
	climateInput = climateTable.asMatrix();
	print(climateInput);//show the matrix

	// Read the climate years
	yearTable = readCSV(yearFile, colNames=F);
	yearMatrix = yearTable.asMatrix();
	yearInput = asInteger(drop(yearMatrix));

	// Main model parameters
	defineConstant("numPops", nrow(migrationInput));
	defineConstant("migrationMatrix", migrationInput);
	defineConstant("climateMatrix", climateInput);
	defineConstant("climateYears", yearInput);
	defineConstant("K", 5000);
	defineConstant("R", 1.01);
	defineConstant("TlocalAdaptation", 2000); // historical mean is reached
	defineConstant("TclimateChange", 4000); // observed climate begins

	///// GENETIC ARCHITECTURE: POLYGENIC
	defineConstant("architecture", "polygenic");
	defineConstant("startAlleleOptimum", 20.0);
	defineConstant("endAlleleOptimum", 100.0);
	defineConstant("m2Proportion", 0.10); // many climate QTLs

	// Selection strength per squared degree C of mismatch. This is the
	// scale-free knob shared by both siblings; the per-copy value is
	// derived from it below.
	defineConstant("selectionStrengthPerDegree", 0.05);

	// Shared genome parameters
	defineConstant("mutationRate", 1e-7);
	defineConstant("genomeLength", 100000);

	// Find the historical years and observed climate years
	historicalRows = which((climateYears >= 1940) & (climateYears <= 1970));
	observedRows = which(climateYears >= 1970);

	// Calculate the historical mean temperature for every population
	historicalMeans = apply(climateMatrix[historicalRows, ],1,"mean(applyValue);");

	defineConstant("historicalMeanClimate", historicalMeans);
	defineConstant("observedClimateRows", observedRows);
	defineConstant("numObservedYears", size(observedRows));
	defineConstant("Tend", TclimateChange + numObservedYears - 1);

	// Temperatures of the final observed climate year
	finalClimateRow = observedRows[size(observedRows) - 1];
	finalTemperatures = drop(climateInput[finalClimateRow,]);

	// Anchor the scale on the coldest historical baseline mean and the
	// warmest temperature of the final observed year
	defineConstant("startTemperature", min(historicalMeans));
	defineConstant("endTemperature", max(finalTemperatures));
	defineConstant("finalClimate", finalTemperatures);

	// Copies per degree C, and selection per squared copy
	defineConstant("temperatureSlope",
		(endAlleleOptimum - startAlleleOptimum) /
		(endTemperature - startTemperature));
	defineConstant("selectionStrength",
		selectionStrengthPerDegree / temperatureSlope^2);

	// The optimum every population must reach by the historical mean phase
	defineConstant("historicalAlleleOptima",
		temperatureToAlleleOptimum(historicalMeanClimate));

	// The optimum every population must track by the final observed year
	defineConstant("finalAlleleOptima",
		temperatureToAlleleOptimum(finalClimate));

	// Mutational supply sanity check: new m2 mutations arising per
	// generation in one deme at carrying capacity
	expectedInflux = 2 * K * mutationRate * genomeLength * m2Proportion;

	catn("Architecture: " + architecture +
		" | allele scale: " + startAlleleOptimum + " to " +
		endAlleleOptimum + " copies | m2 share of genome: " +
		m2Proportion + ".");
	catn("Temperature-to-allele scale: " + startTemperature + " C = " +
		startAlleleOptimum + " copies, " + endTemperature + " C = " +
		endAlleleOptimum + " copies | slope: " + temperatureSlope +
		" copies per degree C.");
	catn("Selection: " + selectionStrengthPerDegree +
		" per squared degree C = " + selectionStrength +
		" per squared copy.");
	catn("Expected new m2 mutations per generation per deme at K: " +
		expectedInflux + ".");

	for (pop in 0:(numPops - 1))
		catn("p" + pop +
			" | Historical mean temperature: " + historicalMeanClimate[pop] +
			" | Historical allele optimum: " + historicalAlleleOptima[pop] +
			" | Final temperature: " + finalClimate[pop] +
			" | Final allele optimum: " + finalAlleleOptima[pop] + ".");

	// Genetics
	initializeMutationRate(mutationRate);
	initializeRecombinationRate(1e-8);
	initializeMutationType("m1", 0.5, "f", 0.0); // neutral mutations
	initializeMutationType("m2", 0.5, "f", 0.0); // climate phenotype mutations
	m2.convertToSubstitution = F; //mutations that fix will not be replaced
	m2.color = "red"; // will be displayed in red in the output
	initializeGenomicElementType("g1", c(m1, m2),
		c(1.0 - m2Proportion, m2Proportion));
	initializeGenomicElement(g1, 0, genomeLength - 1);
}


// Each individual produces a random number of offspring
reproduction(){
	litterSize = rpois(1, R);

	for (offspring in seqLen(litterSize)){
		mate = subpop.sampleIndividuals(1, exclude=individual);

		if (mate.size() > 0)
			subpop.addCrossed(individual, mate);
	}
}


// Create the starting populations
1 early(){
	for (pop in 0:(numPops - 1)){
		sim.addSubpop("p" + pop, K);
	}
}


// Demography, migration, climate selection and density regulation
1:Tend early(){
	///// NON-OVERLAPPING GENERATIONS
	allIndividuals = sim.subpopulations.individuals;
	adults = allIndividuals[allIndividuals.age > 0];

	if (size(adults) > 0)
		sim.killIndividuals(adults);


	///// MIGRATION
	// First choose every migrant without moving anyone
	allMigrants = c();
	allDestinations = c();

	for (sourcePop in 0:(numPops - 1)){
		sourceSubpop = sim.subpopulations[sourcePop];

		if (sourceSubpop.individualCount == 0)
			next;

		// Get the migration rates leaving this population
		migrationRates = drop(migrationMatrix[sourcePop,]);
		migrationRates[sourcePop] = 0.0;
		totalMigrationRate = sum(migrationRates);

		if (totalMigrationRate > 1.0)
			stop("Migration rate above 1.");

		if (totalMigrationRate == 0.0)
			next;

		// Choose how many individuals migrate
		numMigrants = rbinom(1, sourceSubpop.individualCount,
			totalMigrationRate);

		if (numMigrants == 0)
			next;

		// Choose the migrants and their destinations
		popMigrants = sample(sourceSubpop.individuals, numMigrants);
		popDestinations = sample(0:(numPops - 1), numMigrants,
			replace=T, weights=migrationRates);

		allMigrants = c(allMigrants, popMigrants);
		allDestinations = c(allDestinations, popDestinations);
	}

	// Move the migrants after every migration choice has been made
	if (size(allMigrants) > 0){
		for (destinationPop in 0:(numPops - 1)){
			migrants = allMigrants[allDestinations == destinationPop];

			if (size(migrants) > 0)
				sim.subpopulations[destinationPop].takeMigrants(migrants);
		}
	}


	///// CURRENT CLIMATE AND ALLELE OPTIMUM
	// Phase 1: ticks 1-1999 gradually approach each historical optimum
	if (sim.cycle < TlocalAdaptation){
		adaptProgress = asFloat(sim.cycle) / TlocalAdaptation;
		climates = historicalMeanClimate;
		alleleOptima = historicalAlleleOptima * adaptProgress;
		currentYear = "Local Adaptation";
	}

	// Phase 2: ticks 2000-3999 remain at each historical optimum
	else if (sim.cycle < TclimateChange){
		climates = historicalMeanClimate;
		alleleOptima = historicalAlleleOptima;
		currentYear = "Historical Mean";
	}

	// Phase 3: tick 4000 begins the observed climate record with 1970
	else{
		climateYearIndex = sim.cycle - TclimateChange;

		if (climateYearIndex >= numObservedYears)
			climateYearIndex = numObservedYears - 1;

		//observedClimateRows = c(30 (1970), 31, 32, 33...);
		climateRow = observedClimateRows[climateYearIndex];
		climates = drop(climateMatrix[climateRow,]);
		alleleOptima = temperatureToAlleleOptimum(climates);
		currentYear = asString(climateYears[climateRow]);

		//tick 4000, climateYearIndex 0, calendar year 1970
	}


	///// CLIMATE FITNESS
	inds = sim.subpopulations.individuals;

	if (size(inds) > 0){
		phenotypes = asFloat(inds.countOfMutationsOfType(m2));
		popOptima = alleleOptima[inds.subpopulation.id];

		fitness = 1.0 -
			(phenotypes - popOptima)^2 * selectionStrength;
		fitness[fitness < 0.0] = 0.0;

		inds.fitnessScaling = fitness;
		inds.tagF = phenotypes;
	}


	///// DENSITY REGULATION
	for (subpop in sim.subpopulations){
		if (subpop.individualCount > 0)
			subpop.fitnessScaling =
			min(K / subpop.individualCount, 1.5);
	}

	// Save climate values for the output event
	sim.setValue("currentClimates", climates);
	sim.setValue("currentAlleleOptima", alleleOptima);
	sim.setValue("currentClimateYear", currentYear);
}


// Print results and stop if every population is extinct
1:Tend late(){
	totalPopulationSize = sum(sim.subpopulations.individualCount);

	if (totalPopulationSize == 0){
		catn("All populations extinct at tick " + sim.cycle + ".");
		sim.simulationFinished();
	}
	else{
		outputThisGeneration = F;

		if (sim.cycle % 100 == 0)
			outputThisGeneration = T;

		if (sim.cycle >= TclimateChange)
			outputThisGeneration = T;

		if (outputThisGeneration){
			climates = sim.getValue("currentClimates");
			alleleOptima = sim.getValue("currentAlleleOptima");
			currentYear = sim.getValue("currentClimateYear");

			for (subpop in sim.subpopulations){
				if (subpop.individualCount == 0){
					catn("Tick " + sim.cycle + " | Year: " + currentYear +
						" | p" + subpop.id + " : 0" +
						" | Current phenotype : NA" +
						" | Allele optimum : " + alleleOptima[subpop.id] +
						" | Current Temp : " + climates[subpop.id] + " |");
				}
				else{
					phenotypes = subpop.individuals.tagF;
					meanPhenotype = mean(phenotypes);

					catn("Tick " + sim.cycle + " | Year: " + currentYear +
						" | p" + subpop.id + " : " + subpop.individualCount +
						" | Current mean phenotype : " + meanPhenotype +
						" | Allele optimum : " + alleleOptima[subpop.id] +
						" | Current Temp : " + climates[subpop.id] + " |");
				}
			}
		}
	}
}


// Finish after the final observed climate year
Tend late(){
	sim.simulationFinished();
}
